= new Hexagon(*other.boardTiles[row][col]);\n        }\n    }\n}\n\nHexagonGrid::~HexagonGrid()\n{\n    for (int row = 0; row < rows; ++row)\n    {\n        for (int col = 0; col < cols; ++col)\n        {\n            delete boardTiles[row][col];\n        }\n    }\n}\n\nvoid HexagonGrid::initializeHexagons()\n{\n    boardTiles.resize(rows);\n    for (int row = 0; row < rows; ++row)\n    {\n        boardTiles[row].resize(cols);\n    }\n\n    for (int row = 0; row < rows; ++row)\n    {\n        for (int col = 0; col < cols; ++col)\n        {\n            boardTiles[row][col] = new Hexagon(true, hexSize, row, col);\n        }\n    }\n}\n\nvoid HexagonGrid::drawSelectableTiles()\n{\n    for (int row = 0; row < rows; ++row)\n        for (int col = 0; col < cols; ++col)\n            if (boardTiles[row][col]->getTileData()->getPlacedTile())\n                setValidNeighbours(row, col);\n}\n\nvoid HexagonGrid::drawGrid(QGraphicsScene *scene)\n{\n    for (int row = 0; row < rows; ++row)\n        for (int col = 0; col < cols; ++col)\n            boardTiles[row][col]->drawHexagon(row, col, scene);\n    drawSelectableTiles();\n}\n\nvoid HexagonGrid::setValidNeighbours(int row, int col)\n{\n    QVector<std::pair<int, int>> neighbours;\n\n    int colOffsetEvenRow[] = {-1, -1, 0, 1, -1, 0};\n    int rowOffsetEvenRow[] = {0, -1, -1, 0, 1, 1};\n    int colOffsetOddRow[]  = {-1, 0, 1, 1, 0, 1};\n    int rowOffsetOddRow[]  = {0, -1, -1, 0, 1, 1};\n\n    const int *colOffset = (row % 2 == 0) ? colOffsetEvenRow : colOffsetOddRow;\n    const int *rowOffset = (row % 2 == 0) ? rowOffsetEvenRow : rowOffsetOddRow;\n\n    for (int i = 0; i < 6; ++i)\n    {\n        int newRow = row + rowOffset[i];\n        int newCol = col + colOffset[i];\n        if (newRow >= 0 && newRow < boardTiles.size() && newCol >= 0 &&\n            newCol < boardTiles[newRow].size())\n        {\n            neighbours.append({newRow, newCol});\n            Hexagon  *hex  = boardTiles[newRow][newCol];\n            TileData *tile = hex->getTileData();\n\n            if (!tile->getPlacedTile())\n            {\n                tile->setIsValid(true);\n                hex->setBrush(QBrush(QColor(219, 224, 157)));\n            }\n        }\n    }\n}\n\nauto HexagonGrid::getNeighbours(int row, int col) -> QVector<std::pair<int, int>>\n{\n    QVector<std::pair<int, int>> neighbours;\n\n    int colOffsetEvenRow[] = {-1, -1, 0, 1, -1, 0};\n    int rowOffsetEvenRow[] = {0, -1, -1, 0, 1, 1};\n    int colOffsetOddRow[]  = {-1, 0, 1, 1, 0, 1};\n    int rowOffsetOddRow[]  = {0, -1, -1, 0, 1, 1};\n\n    const int *colOffset = (row % 2 == 0) ? colOffsetEvenRow : colOffsetOddRow;\n    const int *rowOffset = (row % 2 == 0) ? rowOffsetEvenRow : rowOffsetOddRow;\n\n    for (int i = 0; i < 6; ++i)\n    {\n        int newRow = row + rowOffset[i];\n        int newCol = col + colOffset[i];\n        if (newRow >= 0 && newRow < boardTiles.size() && newCol >= 0 &&\n            newCol < boardTiles[newRow].size())\n        {\n            neighbours.append({newRow, newCol});\n        }\n    }\n    return neighbours;\n}\n\nauto HexagonGrid::getTiles() -> QVector<QVector<Hexagon *>> &\n{\n    return boardTiles;\n}\n\nauto HexagonGrid::getRows() const -> int\n{\n    return rows;\n}\n\nauto HexagonGrid::getCols() const -> int\n{\n    return cols;\n}\n"},"/home/julijana/Desktop/2026_Analysis_cascadia/cascadia++/cascadia/game/entities/tileData.cpp":{"language":"cpp","mutants":[{"id":"cxx_assign_const:/home/julijana/Desktop/2026_Analysis_cascadia/cascadia++/cascadia/game/entities/tileData.cpp:9:17:9:18","mutatorName":"cxx_assign_const","replacement":"= 42;","location":{"start":{"line":9,"column":17},"end":{"line":9,"column":18}},"status":"Survived"},{"id":"cxx_assign_const:/home/julijana/Desktop/2026_Analysis_cascadia/cascadia++/cascadia/game/entities/tileData.cpp:7:17:7:18","mutatorName":"cxx_assign_const","replacement":"= 42;","location":{"start":{"line":7,"column":17},"end":{"line":7,"column":18}},"status":"Survived"},{"id":"cxx_assign_const:/home/julijana/Desktop/2026_Analysis_cascadia/cascadia++/cascadia/game/entities/tileData.cpp:41:13:41:14","mutatorName":"cxx_assign_const","replacement":"= 42;","location":{"start":{"line":41,"column":13},"end":{"line":41,"column":14}},"status":"Killed"},{"id":"cxx_assign_const:/home/julijana/Desktop/2026_Analysis_cascadia/cascadia++/cascadia/game/entities/tileData.cpp:31:16:31:17","mutatorName":"cxx_assign_const","replacement":"= 42;","location":{"start":{"line":31,"column":16},"end":{"line":31,"column":17}},"status":"Killed"}],"source":"#include \"tileData.h\"\n\nTileData::TileData() = default;\n\nTileData::TileData(int row, int col) : row(row), col(col)\n{\n    placedTile  = false;\n    placedToken = \"\";\n    rotation    = 0;\n}\n\nTileData::~TileData() = default;\n\nauto TileData::getRow() const -> int\n{\n    return row;\n}\n\nauto TileData::getCol() const -> int\n{\n    return col;\n}\n\nauto TileData::getPlacedTile() const -> bool\n{\n    return placedTile;\n}\n\nvoid TileData::setPlacedTile(bool newPlacedTile)\n{\n    placedTile = newPlacedTile;\n}\n\nauto TileData::getIsValid() const -> bool\n{\n    return isValid;\n}\n\nvoid TileData::setIsValid(bool newIsValid)\n{\n    isValid = newIsValid;\n}\n\nauto TileData::getPlacedToken() const -> QString\n{\n    return placedToken;\n}\n\nvoid TileData::setPlacedToken(const QString &newPlacedToken)\n{\n    placedToken = newPlacedToken;\n}\n\nauto TileData::getAnimals() const -> QVector<QString>\n{\n    return animals;\n}\n\nvoid TileData::setAnimals(const QVector<QString> &newAnimals)\n{\n    animals = newAnimals;\n}\n\nauto TileData::getHabitats() const -> QVector<QString>\n{\n    return habitats;\n}\n\nvoid TileData::setHabitats(const QVector<QString> &newHabitats)\n{\n    habitats = newHabitats;\n}\n\nauto TileData::getRotation() const -> int\n{\n    return rotation;\n}\n\nvoid TileData::setRotation(int newRotation)\n{\n    rotation = newRotation;\n}\n\nauto TileData::getId() const -> int\n{\n    return id;\n}\n\nvoid TileData::setId(int newId)\n{\n    id = newId;\n}\n\nauto TileData::toVariant() const -> QVariant\n{\n    QVariantMap map;\n    map.insert(\"id\", id);\n    map.insert(\"row\", row);\n    map.insert(\"col\", col);\n    map.insert(\"placedTile\", placedTile);\n    map.insert(\"isValid\", isValid);\n    map.insert(\"placedToken\", placedToken);\n    map.insert(\"rotation\", rotation);\n\n    QVariantList listAnimals;\n    for (const auto &animal : animals)\n    {\n        listAnimals.append(animal);\n    }\n    map.insert(\"animals\", listAnimals);\n\n    QVariantList listHabitats;\n    for (const auto &habitat : habitats)\n    {\n        listHabitats.append(habitat);\n    }\n    map.insert(\"habitats\", listHabitats);\n\n    return map;\n}\n\nvoid TileData::fromVariant(const QVariant &variant)\n{\n    QVariantMap map = variant.toMap();\n    id          = map.value(\"id\").toInt();\n    row         = map.value(\"row\").toInt();\n    col         = map.value(\"col\").toInt();\n    placedTile  = map.value(\"placedTile\").toBool();\n    isValid     = map.value(\"isValid\").toBool();\n    placedToken = map.value(\"placedToken\").toString();\n    rotation    = map.value(\"rotation\").toInt();\n\n    animals.clear();\n\n    QVariantList listAnimals = map.value(\"animals\").toList();\n    animals.reserve(listAnimals.size());\n\n    for (const QVariant &animal : listAnimals)\n    {\n        animals.push_back(animal.toString());\n    }\n\n    habitats.clear();\n\n    QVariantList listHabitats = map.value(\"habitats\").toList();\n    habitats.reserve(listHabitats.size());\n\n    for (const QVariant &habitat : listHabitats)\n    {\n        habitats.push_back(habitat.toString());\n    }\n}\n\nvoid TileData::setIndex(int newIndex)\n{\n    index = newIndex;\n}\n\nauto TileData::getIndex() const -> int\n{\n    return index;\n}\n"}},"thresholds":{"high":80,"low":60},"schemaVersion":"1.7","framework":{"brandingInformation":{},"name":"Mull","version":"0.34.1, LLVM 18.1.8"},"mutationScore":38}